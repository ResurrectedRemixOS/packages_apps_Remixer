<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <gradient
                android:angle="315"
                android:startColor="@android:color/system_accent1_900"
                android:endColor="@android:color/system_accent1_1000" />
            <stroke
                android:width="1dp"
                android:color="@color/remixer_hero_stroke" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <gradient
                android:type="radial"
                android:centerX="0.38"
                android:centerY="0.42"
                android:gradientRadius="85%"
                android:startColor="@color/remixer_hero_glow"
                android:endColor="@color/remixer_hero_glow_end" />
        </shape>
    </item>
</layer-list>
