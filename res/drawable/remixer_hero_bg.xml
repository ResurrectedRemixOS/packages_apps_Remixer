<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <gradient
                android:angle="315"
                android:startColor="#3D0011"
                android:endColor="#0B0003" />
            <stroke
                android:width="1dp"
                android:color="#40FF003F" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <gradient
                android:type="radial"
                android:centerX="0.38"
                android:centerY="0.42"
                android:gradientRadius="85%"
                android:startColor="#59FF003F"
                android:endColor="#00FF003F" />
        </shape>
    </item>
</layer-list>
