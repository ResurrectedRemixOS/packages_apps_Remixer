    <string name="nightstand_summary">चार्ज हुँदा रातमा सधैं खुल्ने स्क्रिनमा मधुरो सिरानी घडी</string>
    <string-array name="nightstand_when_entries">
        <item>"अफ छ"</item>
        <item>रातमा चार्जरमा</item>
        <item>हरेक रात, तोकिएको समयमा</item>
        <item>सुत्ने मोड सक्रिय हुँदा</item>
    </string-array>
    <string name="nightstand_from">रात सुरु हुन्छ</string>
