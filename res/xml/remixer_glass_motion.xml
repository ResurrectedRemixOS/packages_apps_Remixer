<!-- Liquid Glass: panels that grow out of what opened them, and glass that melts together -->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    android:title="@string/glass_motion_title">

    <lineageos.preference.SystemSettingSwitchPreference
        android:key="rr_glass_morph"
        android:title="@string/glass_morph_title"
        android:summary="@string/glass_morph_summary"
        android:defaultValue="true" />

    <com.resurrection.settings.preferences.SystemSettingListPreference
        android:key="rr_glass_morph_style"
        android:title="@string/glass_morph_style_title"
        android:summary="%s"
        android:dependency="rr_glass_morph"
        android:entries="@array/glass_morph_style_entries"
        android:entryValues="@array/glass_morph_style_values"
        android:defaultValue="0" />

    <com.resurrection.settings.preferences.SystemSettingListPreference
        android:key="rr_glass_morph_speed"
        android:title="@string/glass_morph_speed_title"
        android:summary="%s"
        android:dependency="rr_glass_morph"
        android:entries="@array/glass_morph_speed_entries"
        android:entryValues="@array/glass_morph_speed_values"
        android:defaultValue="1" />

    <lineageos.preference.SystemSettingSwitchPreference
        android:key="rr_glass_melt"
        android:title="@string/glass_melt_title"
        android:summary="@string/liquid_glass_melt_summary"
        android:defaultValue="false" />

    <com.resurrection.settings.preferences.SystemSettingListPreference
        android:key="rr_glass_melt_reach"
        android:title="@string/glass_melt_reach_title"
        android:summary="%s"
        android:dependency="rr_glass_melt"
        android:entries="@array/glass_melt_reach_entries"
        android:entryValues="@array/glass_melt_reach_values"
        android:defaultValue="1" />

    <Preference
        android:key="glass_melt_try"
        android:title="@string/glass_melt_try_title"
        android:summary="@string/glass_melt_try_summary"
        android:dependency="rr_glass_melt">
        <intent
            android:targetPackage="com.android.settings"
            android:targetClass="com.resurrection.settings.glass.GlassMeltActivity" />
    </Preference>

    <com.android.settingslib.widget.FooterPreference
        android:key="glass_motion_note"
        android:title="@string/liquid_glass_motion_note" />
</PreferenceScreen>
