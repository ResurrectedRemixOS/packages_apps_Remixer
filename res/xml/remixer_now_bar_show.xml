<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    android:title="@string/now_bar_show_page">

    <lineageos.preference.SystemSettingSwitchPreference
        android:key="now_bar_music"
        android:title="@string/now_bar_music"
        android:defaultValue="true" />
    <lineageos.preference.SystemSettingSwitchPreference
        android:key="now_bar_timers"
        android:title="@string/now_bar_timers"
        android:defaultValue="true" />
    <lineageos.preference.SystemSettingSwitchPreference
        android:key="now_bar_calls"
        android:title="@string/now_bar_calls"
        android:defaultValue="true" />
    <lineageos.preference.SystemSettingSwitchPreference
        android:key="now_bar_hide_call"
        android:title="@string/now_bar_hide_call"
        android:summary="@string/now_bar_hide_call_summary"
        android:defaultValue="true"
        android:dependency="now_bar_calls" />
    <lineageos.preference.SystemSettingSwitchPreference
        android:key="now_bar_live_updates"
        android:title="@string/now_bar_live"
        android:summary="@string/now_bar_live_summary"
        android:defaultValue="true" />
    <Preference
        android:key="now_bar_live_apps"
        android:title="@string/now_bar_live_apps"
        android:summary="@string/now_bar_live_apps_all"
        android:dependency="now_bar_live_updates" />
    <Preference
        android:key="now_bar_pin"
        android:title="@string/now_bar_pin"
        android:summary="@string/now_bar_pin_none"
        android:dependency="now_bar_live_updates" />
    <com.resurrection.settings.preferences.SystemSettingListPreference
        android:key="now_bar_scores"
        android:title="@string/now_bar_scores"
        android:entries="@array/now_bar_scores_entries"
        android:entryValues="@array/now_bar_scores_values"
        android:summary="%s"
        android:defaultValue="1" />
    <lineageos.preference.SystemSettingSwitchPreference
        android:key="now_bar_recording"
        android:title="@string/now_bar_recording"
        android:defaultValue="true" />
    <lineageos.preference.SystemSettingSwitchPreference
        android:key="now_bar_charging"
        android:title="@string/now_bar_charging"
        android:defaultValue="false" />
    <lineageos.preference.SystemSettingSwitchPreference
        android:key="now_bar_flashlight"
        android:title="@string/now_bar_flashlight"
        android:defaultValue="false" />

    <PreferenceCategory
        android:key="now_bar_where"
        android:title="@string/now_bar_where">
        <lineageos.preference.SystemSettingSwitchPreference
            android:key="now_bar_aod"
            android:title="@string/now_bar_aod"
            android:defaultValue="true" />
        <lineageos.preference.SystemSettingSwitchPreference
            android:key="now_bar_chip"
            android:title="@string/now_bar_chip"
            android:summary="@string/now_bar_chip_summary"
            android:defaultValue="true" />
    </PreferenceCategory>
</PreferenceScreen>
