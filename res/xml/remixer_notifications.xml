<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    android:title="@string/remixer_notifications">

    <Preference
        android:key="edge_light"
        android:title="@string/edge_light_title"
        android:summary="@string/edge_light_summary"
        android:fragment="com.resurrection.settings.edgelight.EdgeLightSettings" />

    <PreferenceCategory
        android:key="notification_icons_category"
        android:title="@string/notification_icons_category">

        <lineageos.preference.SystemSettingSwitchPreference
            android:key="notification_use_app_icons"
            android:title="@string/notification_app_icons_title"
            android:summary="@string/notification_app_icons_summary"
            android:defaultValue="true" />

    </PreferenceCategory>

    <lineageos.preference.LineagePartsPreference
        android:key="charging_sounds_settings" />

</PreferenceScreen>
