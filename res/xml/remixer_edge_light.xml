<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:title="@string/edge_light_title">

    <com.android.settingslib.widget.LayoutPreference
        android:key="edge_light_preview"
        android:layout="@layout/edge_light_preview"
        android:selectable="false"
        app:allowDividerBelow="false" />

    <lineageos.preference.SystemSettingMainSwitchPreference
        android:key="edge_light_enabled"
        android:title="@string/edge_light_title"
        android:summary="@string/edge_light_summary"
        android:defaultValue="false" />

    <PreferenceCategory
        android:key="edge_light_moments"
        android:title="@string/edge_light_moments_title">

        <com.resurrection.settings.preferences.MomentPreference
            android:key="edge_light_moment_notifications"
            android:title="@string/edge_light_moment_notifications"
            android:defaultValue="true"
            android:dependency="edge_light_enabled" />

        <com.resurrection.settings.preferences.MomentPreference
            android:key="edge_light_moment_calls"
            android:title="@string/edge_light_moment_calls"
            android:defaultValue="true"
            android:dependency="edge_light_enabled" />

        <com.resurrection.settings.preferences.MomentPreference
            android:key="edge_light_moment_alarms"
            android:title="@string/edge_light_moment_alarms"
            android:defaultValue="true"
            android:dependency="edge_light_enabled" />

        <com.resurrection.settings.preferences.MomentPreference
            android:key="edge_light_moment_plugged"
            android:title="@string/edge_light_moment_plugged"
            android:defaultValue="true"
            android:dependency="edge_light_enabled" />

        <com.resurrection.settings.preferences.MomentPreference
            android:key="edge_light_moment_battery_low"
            android:title="@string/edge_light_moment_battery_low"
            android:defaultValue="false"
            android:dependency="edge_light_enabled" />

        <com.resurrection.settings.preferences.MomentPreference
            android:key="edge_light_moment_unlock"
            android:title="@string/edge_light_moment_unlock"
            android:defaultValue="false"
            android:dependency="edge_light_enabled" />

        <com.android.settingslib.widget.FooterPreference
            android:key="edge_light_moments_footer"
            android:title="@string/edge_light_moments_footer"
            android:selectable="false" />
    </PreferenceCategory>

    <PreferenceCategory
        android:key="edge_light_look"
        android:title="@string/edge_light_look_title">

    <com.resurrection.settings.preferences.SystemSettingListPreference
        android:key="edge_light_color_mode"
        android:title="@string/edge_light_color_mode_title"
        android:entries="@array/edge_light_color_mode_entries"
        android:entryValues="@array/edge_light_color_mode_values"
        android:summary="%s"
        android:defaultValue="accent"
        android:dependency="edge_light_enabled" />

    <com.resurrection.settings.preferences.SystemSettingColorPreference
        android:key="edge_light_custom_color"
        android:title="@string/edge_light_custom_color_title"
        android:defaultValue="#FFFFFF"
        android:dependency="edge_light_enabled" />

    <com.resurrection.settings.preferences.SystemSettingListPreference
        android:key="edge_light_style"
        android:title="@string/edge_light_style_title"
        android:entries="@array/edge_light_style_entries"
        android:entryValues="@array/edge_light_style_values"
        android:summary="%s"
        android:defaultValue="default"
        android:dependency="edge_light_enabled" />

    <com.resurrection.settings.preferences.SystemSettingListPreference
        android:key="edge_light_animation_effect"
        android:title="@string/edge_light_animation_effect_title"
        android:entries="@array/edge_light_animation_entries"
        android:entryValues="@array/edge_light_animation_values"
        android:summary="%s"
        android:defaultValue="none"
        android:dependency="edge_light_enabled" />

    <com.resurrection.settings.preferences.SystemSettingSeekBarPreference
        android:key="edge_light_pulse_count"
        android:title="@string/edge_light_pulse_count_title"
        android:summary="@string/edge_light_pulse_count_summary"
        android:defaultValue="3"
        android:max="5"
        app:min="1"
        app:showSeekBarValue="true"
        android:dependency="edge_light_enabled" />

    <com.resurrection.settings.preferences.SystemSettingSeekBarPreference
        android:key="edge_light_stroke_width"
        android:title="@string/edge_light_stroke_width_title"
        android:summary="@string/edge_light_stroke_width_summary"
        android:defaultValue="8"
        android:max="32"
        app:min="2"
        app:showSeekBarValue="true"
        android:dependency="edge_light_enabled" />

    <com.resurrection.settings.preferences.SystemSettingSeekBarPreference
        android:key="edge_light_spread"
        android:title="@string/edge_light_spread_title"
        android:summary="@string/edge_light_spread_summary"
        android:defaultValue="0"
        android:max="60"
        app:min="0"
        app:showSeekBarValue="true"
        android:dependency="edge_light_enabled" />

    <com.resurrection.settings.preferences.SystemSettingSeekBarPreference
        android:key="edge_light_intensity"
        android:title="@string/edge_light_intensity_title"
        android:summary="@string/edge_light_intensity_summary"
        android:defaultValue="0"
        android:max="100"
        app:min="0"
        app:showSeekBarValue="true"
        android:dependency="edge_light_enabled" />
    </PreferenceCategory>
</PreferenceScreen>
