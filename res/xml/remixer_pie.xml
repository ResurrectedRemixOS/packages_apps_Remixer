<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:title="@string/pie_title">

    <lineageos.preference.SystemSettingMainSwitchPreference
        android:key="pie_controls"
        android:title="@string/pie_title"
        android:summary="@string/pie_summary"
        android:defaultValue="false" />

    <com.resurrection.settings.preferences.SystemSettingListPreference
        android:key="pie_edges"
        android:title="@string/pie_edges"
        android:entries="@array/pie_edges_entries"
        android:entryValues="@array/pie_edges_values"
        android:summary="%s"
        android:defaultValue="2"
        android:dependency="pie_controls" />

    <com.resurrection.settings.preferences.SystemSettingListPreference
        android:key="pie_zone"
        android:title="@string/pie_zone"
        android:entries="@array/pie_zone_entries"
        android:entryValues="@array/pie_zone_values"
        android:summary="%s"
        android:defaultValue="0"
        android:dependency="pie_controls" />

    <com.resurrection.settings.preferences.SystemSettingListPreference
        android:key="pie_style"
        android:title="@string/pie_style"
        android:entries="@array/pie_style_entries"
        android:entryValues="@array/pie_style_values"
        android:summary="%s"
        android:defaultValue="0"
        android:dependency="pie_controls" />

    <MultiSelectListPreference
        android:key="pie_items_picker"
        android:title="@string/pie_items"
        android:entries="@array/pie_items_entries"
        android:entryValues="@array/pie_items_values"
        android:persistent="false"
        android:dependency="pie_controls" />

    <lineageos.preference.SystemSettingSwitchPreference
        android:key="pie_clock"
        android:title="@string/pie_clock"
        android:defaultValue="true"
        android:dependency="pie_controls" />

    <com.resurrection.settings.preferences.SystemSettingSeekBarPreference
        android:key="pie_size"
        android:title="@string/pie_size"
        android:defaultValue="100"
        android:max="150"
        app:min="60"
        app:showSeekBarValue="true"
        android:dependency="pie_controls" />

    <com.android.settingslib.widget.FooterPreference
        android:key="pie_footer"
        android:title="@string/pie_footer"
        android:selectable="false" />
</PreferenceScreen>
