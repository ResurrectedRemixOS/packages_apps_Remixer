<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    android:title="@string/remixer_lockscreen">

    <Preference
        android:key="remixer_clock_faces"
        android:title="@string/remixer_clock_faces" />

    <Preference
        android:key="remixer_udfps_icon"
        android:title="@string/remixer_udfps_icon"
        android:summary="@string/remixer_udfps_icon_summary" />

    <Preference
        android:key="remixer_udfps_animation"
        android:title="@string/remixer_udfps_animation"
        android:summary="@string/remixer_udfps_animation_summary" />

    <Preference
        android:key="remixer_lock_media_style"
        android:title="@string/remixer_lock_media_style" />

    <Preference
        android:key="remixer_quick_launch"
        android:title="@string/quick_launch_main" />

    <Preference
        android:key="charging_glow_page"
        android:title="@string/charging_glow_title"
        android:summary="@string/charging_glow_summary"
        android:fragment="com.resurrection.settings.chargingglow.ChargingGlowSettings" />

    <lineageos.preference.SystemSettingSwitchPreference
        android:key="pocket_judge"
        android:title="@string/pocket_mode_title"
        android:summary="@string/pocket_mode_summary"
        android:defaultValue="false" />

    <lineageos.preference.SystemSettingSwitchPreference
        android:key="lockscreen_battery_info"
        android:title="@string/lockscreen_battery_info_title"
        android:summary="@string/lockscreen_battery_info_summary"
        android:defaultValue="true" />

    <lineageos.preference.SystemSettingSwitchPreference
        android:key="screen_on_time_info"
        android:title="@string/screen_on_time_title"
        android:summary="@string/screen_on_time_summary"
        android:defaultValue="true" />

    <Preference
        android:key="remixer_weather"
        android:title="@string/remixer_weather"
        android:summary="@string/remixer_weather_page_summary"
        android:fragment="com.resurrection.settings.RemixerSection">
        <extra android:name="section" android:value="weather" />
    </Preference>

</PreferenceScreen>
