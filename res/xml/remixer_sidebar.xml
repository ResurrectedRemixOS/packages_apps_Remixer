<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    android:title="@string/sidebar_settings_title">

    <Preference
        android:key="sidebar_settings"
        android:title="@string/sidebar_apps_title"
        android:summary="@string/sidebar_apps_summary">
        <intent
            android:targetPackage="com.libremobileos.sidebar"
            android:targetClass="com.libremobileos.sidebar.ui.sidebar.SidebarSettingsActivity" />
    </Preference>

    <com.resurrection.settings.preferences.SystemSettingListPreference
        android:key="rr_sidebar_style"
        android:title="@string/sidebar_style_title"
        android:entries="@array/sidebar_style_entries"
        android:entryValues="@array/sidebar_style_values"
        android:summary="%s"
        android:defaultValue="1" />

    <com.resurrection.settings.preferences.SystemSettingListPreference
        android:key="rr_sidebar_handle_size"
        android:title="@string/sidebar_handle_size_title"
        android:entries="@array/sidebar_handle_size_entries"
        android:entryValues="@array/sidebar_handle_size_values"
        android:summary="%s"
        android:defaultValue="1" />

    <lineageos.preference.SystemSettingSwitchPreference
        android:key="rr_sidebar_tools"
        android:title="@string/sidebar_tools_title"
        android:summary="@string/sidebar_tools_summary"
        android:defaultValue="true" />

    <com.android.settingslib.widget.FooterPreference
        android:key="sidebar_footer"
        android:title="@string/sidebar_footer"
        android:selectable="false" />
</PreferenceScreen>
