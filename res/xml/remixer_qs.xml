<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    android:title="@string/remixer_qs">

    <Preference
        android:key="remixer_qs_style"
        android:title="@string/remixer_qs_style" />

    <Preference
        android:key="remixer_qs_media_style"
        android:title="@string/remixer_lock_media_style" />

    <com.resurrection.settings.preferences.SystemSettingListPreference
        android:key="rr_qs_media_tile_size"
        android:title="@string/remixer_qs_media_tile_size"
        android:summary="%s"
        android:entries="@array/remixer_qs_media_tile_size_entries"
        android:entryValues="@array/remixer_qs_media_tile_size_values"
        android:defaultValue="1" />

    <Preference
        android:key="remixer_headers"
        android:title="@string/remixer_headers"
        android:summary="@string/remixer_headers_summary" />

</PreferenceScreen>
