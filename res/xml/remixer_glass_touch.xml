<!-- Liquid Glass: touch glow, squish, tap buzz and the glass selector -->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:title="@string/glass_touch_title">

    <lineageos.preference.SystemSettingSwitchPreference
        android:key="rr_glass_touch_glow"
        android:title="@string/glass_touch_glow_title"
        android:summary="@string/glass_touch_glow_summary"
        android:defaultValue="true" />

    <com.resurrection.settings.preferences.SystemSettingListPreference
        android:key="rr_glass_touch_glow_color"
        android:title="@string/glass_touch_glow_color_title"
        android:summary="%s"
        android:dependency="rr_glass_touch_glow"
        android:entries="@array/glass_touch_glow_color_entries"
        android:entryValues="@array/glass_touch_glow_color_values"
        android:defaultValue="0" />

    <com.resurrection.settings.preferences.SystemSettingSeekBarPreference
        android:key="rr_glass_touch_glow_size"
        android:title="@string/glass_touch_glow_size_title"
        android:dependency="rr_glass_touch_glow"
        android:defaultValue="100"
        android:max="200"
        app:min="50"
        app:seekBarIncrement="25"
        app:textStart="@string/glass_touch_glow_size_small"
        app:textEnd="@string/glass_touch_glow_size_large"
        app:updatesContinuously="true" />

    <com.resurrection.settings.preferences.SystemSettingListPreference
        android:key="rr_glass_squish"
        android:title="@string/glass_squish_title"
        android:summary="%s"
        android:entries="@array/glass_squish_entries"
        android:entryValues="@array/glass_squish_values"
        android:defaultValue="2" />

    <com.resurrection.settings.preferences.SystemSettingListPreference
        android:key="rr_glass_tap_buzz"
        android:title="@string/glass_tap_buzz_title"
        android:summary="%s"
        android:entries="@array/glass_tap_buzz_entries"
        android:entryValues="@array/glass_tap_buzz_values"
        android:defaultValue="0" />

    <lineageos.preference.SystemSettingSwitchPreference
        android:key="rr_glass_selector"
        android:title="@string/glass_selector_title"
        android:summary="@string/glass_selector_summary"
        android:defaultValue="true" />

    <com.resurrection.settings.preferences.SystemSettingListPreference
        android:key="rr_glass_selector_magnify"
        android:title="@string/glass_selector_magnify_title"
        android:summary="%s"
        android:dependency="rr_glass_selector"
        android:entries="@array/glass_selector_magnify_entries"
        android:entryValues="@array/glass_selector_magnify_values"
        android:defaultValue="1" />

    <lineageos.preference.SystemSettingSwitchPreference
        android:key="rr_glass_stretch"
        android:title="@string/glass_stretch_title"
        android:summary="@string/glass_stretch_summary"
        android:dependency="rr_glass_selector"
        android:defaultValue="true" />

    <com.android.settingslib.widget.FooterPreference
        android:key="glass_touch_note"
        android:title="@string/liquid_glass_touch_note" />
</PreferenceScreen>
