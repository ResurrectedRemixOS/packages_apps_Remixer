<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    android:title="@string/volume_page_title">

    <com.resurrection.settings.preferences.SystemSettingListPreference
        android:key="rr_volume_style"
        android:title="@string/volume_style_title"
        android:entries="@array/volume_style_entries"
        android:entryValues="@array/volume_style_values"
        android:summary="%s"
        android:defaultValue="0" />

    <PreferenceCategory
        android:key="volume_behavior"
        android:title="@string/volume_behavior">

        <lineageos.preference.LineageSecureSettingSwitchPreference
            android:key="volume_panel_on_left"
            android:title="@string/volume_on_left_title"
            android:summary="@string/volume_on_left_summary"
            android:defaultValue="false" />

        <lineageos.preference.SystemSettingSwitchPreference
            android:key="rr_volume_ringer"
            android:title="@string/volume_ringer_title"
            android:defaultValue="true" />

        <lineageos.preference.SystemSettingSwitchPreference
            android:key="rr_volume_tick"
            android:title="@string/volume_tick_title"
            android:defaultValue="true" />

        <com.resurrection.settings.preferences.SecureSettingListPreference
            android:key="volume_dialog_dismiss_timeout"
            android:title="@string/volume_timeout_title"
            android:entries="@array/volume_timeout_entries"
            android:entryValues="@array/volume_timeout_values"
            android:summary="%s"
            android:defaultValue="3000" />
    </PreferenceCategory>

    <com.android.settingslib.widget.FooterPreference
        android:key="volume_footer"
        android:title="@string/volume_footer"
        android:selectable="false" />
</PreferenceScreen>
