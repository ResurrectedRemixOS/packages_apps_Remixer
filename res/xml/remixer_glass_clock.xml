<!-- The Glass clock, a lock screen clock face of its own: it's glass whether or not glass is on
     elsewhere. GlassClockView reads these keys; defaults are GlassSettings' own. -->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:title="@string/glass_clock_title">

    <Preference
        android:key="glass_clock_faces"
        android:title="@string/glass_clock_all_faces"
        android:summary="@string/glass_clock_all_faces_summary" />

    <PreferenceCategory
        android:key="glass_clock_glass"
        android:title="@string/glass_clock_section_glass">

        <com.resurrection.settings.glass.GlassChipsPreference
            android:key="rr_glass_clock_style"
            android:title="@string/glass_clock_style_title"
            android:entries="@array/glass_clock_style_entries"
            android:entryValues="@array/glass_clock_style_values"
            android:defaultValue="0" />

        <lineageos.preference.SystemSettingSwitchPreference
            android:key="rr_glass_clock_readable"
            android:title="@string/glass_clock_readable_title"
            android:summary="@string/glass_clock_readable_summary"
            android:defaultValue="true" />

        <com.resurrection.settings.glass.GlassChipsPreference
            android:key="rr_glass_clock_depth"
            android:title="@string/glass_clock_depth_title"
            android:entries="@array/glass_clock_depth_entries"
            android:entryValues="@array/glass_clock_depth_values"
            android:defaultValue="1" />

        <com.resurrection.settings.preferences.SystemSettingSeekBarPreference
            android:key="rr_glass_clock_bend"
            android:title="@string/glass_clock_bend_title"
            android:defaultValue="50"
            android:max="100"
            app:min="0"
            app:seekBarIncrement="5"
            app:textStart="@string/glass_bend_flat"
            app:textEnd="@string/glass_bend_strong"
            app:updatesContinuously="true" />

        <com.resurrection.settings.preferences.SystemSettingSeekBarPreference
            android:key="rr_glass_clock_light"
            android:title="@string/glass_clock_light_title"
            android:defaultValue="70"
            android:max="100"
            app:min="0"
            app:seekBarIncrement="5"
            app:textStart="@string/glass_rim_light_none"
            app:textEnd="@string/glass_rim_light_bright"
            app:updatesContinuously="true" />

        <com.resurrection.settings.preferences.SystemSettingSeekBarPreference
            android:key="rr_glass_clock_rainbow"
            android:title="@string/glass_clock_rainbow_title"
            android:defaultValue="40"
            android:max="100"
            app:min="0"
            app:seekBarIncrement="5"
            app:textStart="@string/glass_rainbow_none"
            app:textEnd="@string/glass_rainbow_vivid"
            app:updatesContinuously="true" />

        <com.resurrection.settings.preferences.SystemSettingSeekBarPreference
            android:key="rr_glass_clock_shadow"
            android:title="@string/glass_clock_shadow_title"
            android:defaultValue="35"
            android:max="100"
            app:min="0"
            app:seekBarIncrement="5"
            app:textStart="@string/glass_shadow_none"
            app:textEnd="@string/glass_shadow_dark"
            app:updatesContinuously="true" />
    </PreferenceCategory>

    <PreferenceCategory
        android:key="glass_clock_numbers"
        android:title="@string/glass_clock_section_numbers">

        <com.resurrection.settings.glass.GlassChipsPreference
            android:key="rr_glass_clock_weight"
            android:title="@string/glass_clock_weight_title"
            android:entries="@array/glass_clock_weight_entries"
            android:entryValues="@array/glass_clock_weight_values"
            android:defaultValue="850" />

        <com.resurrection.settings.preferences.SystemSettingSeekBarPreference
            android:key="rr_glass_clock_roundness"
            android:title="@string/glass_clock_roundness_title"
            android:defaultValue="100"
            android:max="100"
            app:min="0"
            app:seekBarIncrement="10"
            app:textStart="@string/glass_clock_roundness_crisp"
            app:textEnd="@string/glass_clock_roundness_round"
            app:updatesContinuously="true" />

        <com.resurrection.settings.glass.GlassChipsPreference
            android:key="rr_glass_clock_width"
            android:title="@string/glass_clock_width_title"
            android:entries="@array/glass_clock_width_entries"
            android:entryValues="@array/glass_clock_width_values"
            android:defaultValue="100" />

        <com.resurrection.settings.glass.GlassChipsPreference
            android:key="rr_glass_clock_layout"
            android:title="@string/glass_clock_layout_title"
            android:entries="@array/glass_clock_layout_entries"
            android:entryValues="@array/glass_clock_layout_values"
            android:defaultValue="0" />
    </PreferenceCategory>

    <com.android.settingslib.widget.FooterPreference
        android:key="glass_clock_note"
        android:title="@string/liquid_glass_clock_note" />
</PreferenceScreen>
