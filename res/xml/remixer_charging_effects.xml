<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:title="@string/charging_effects_title">

    <lineageos.preference.SystemSettingMainSwitchPreference
        android:key="charging_animation_enabled"
        android:title="@string/charging_effects_title"
        android:defaultValue="false" />

    <com.resurrection.settings.preferences.SystemSettingListPreference
        android:key="charging_animation_style"
        android:title="@string/charging_effects_style"
        android:entries="@array/charging_effects_style_entries"
        android:entryValues="@array/charging_effects_style_values"
        android:defaultValue="0"
        android:summary="%s"
        android:dependency="charging_animation_enabled" />

    <com.resurrection.settings.preferences.SystemSettingListPreference
        android:key="charging_color_mode"
        android:title="@string/charging_effects_color"
        android:entries="@array/charging_effects_color_entries"
        android:entryValues="@array/charging_effects_color_values"
        android:defaultValue="1"
        android:summary="%s"
        android:dependency="charging_animation_enabled" />

    <com.resurrection.settings.preferences.SystemSettingSeekBarPreference
        android:key="charging_ripple_opacity"
        android:title="@string/charging_effects_opacity"
        android:defaultValue="100"
        android:max="100"
        app:min="10"
        app:showSeekBarValue="true"
        android:dependency="charging_animation_enabled" />

    <com.resurrection.settings.preferences.SystemSettingSeekBarPreference
        android:key="charging_glow_intensity"
        android:title="@string/charging_effects_glow"
        android:defaultValue="80"
        android:max="100"
        app:min="0"
        app:showSeekBarValue="true"
        android:dependency="charging_animation_enabled" />

    <com.resurrection.settings.preferences.SystemSettingListPreference
        android:key="charging_image_flow_style"
        android:title="@string/charging_effects_image"
        android:defaultValue="0"
        android:summary="%s"
        android:dependency="charging_animation_enabled" />

    <com.resurrection.settings.preferences.SystemSettingSeekBarPreference
        android:key="charging_image_flow_opacity"
        android:title="@string/charging_effects_image_opacity"
        android:defaultValue="80"
        android:max="100"
        app:min="10"
        app:showSeekBarValue="true"
        android:dependency="charging_animation_enabled" />

    <com.resurrection.settings.preferences.SystemSettingSeekBarPreference
        android:key="charging_image_flow_strength"
        android:title="@string/charging_effects_image_strength"
        android:defaultValue="5"
        android:max="10"
        app:min="1"
        app:showSeekBarValue="true"
        android:dependency="charging_animation_enabled" />

    <lineageos.preference.SystemSettingSwitchPreference
        android:key="charging_show_on_lockscreen"
        android:title="@string/charging_effects_show_lockscreen"
        android:defaultValue="true"
        android:dependency="charging_animation_enabled" />

    <lineageos.preference.SystemSettingSwitchPreference
        android:key="charging_show_on_aod"
        android:title="@string/charging_effects_show_aod"
        android:defaultValue="true"
        android:dependency="charging_animation_enabled" />

    <com.android.settingslib.widget.FooterPreference
        android:key="charging_effects_footer"
        android:title="@string/charging_effects_footer"
        android:selectable="false" />

</PreferenceScreen>
