<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    android:title="@string/remixer_misc">

    <com.resurrection.settings.preferences.SystemSettingListPreference
        android:key="rr_volume_style"
        android:title="@string/volume_style_title"
        android:entries="@array/volume_style_entries"
        android:entryValues="@array/volume_style_values"
        android:summary="%s"
        android:defaultValue="0" />

    <Preference
        android:key="backup_page"
        android:title="@string/backup_title"
        android:summary="@string/backup_summary"
        android:fragment="com.resurrection.settings.backup.BackupSettings" />

    <Preference
        android:key="charge_report_page"
        android:title="@string/charge_report_title"
        android:summary="@string/charge_report_summary"
        android:fragment="com.resurrection.settings.chargereport.ChargeReportSettings" />

    <Preference
        android:key="remixer_spoofing"
        android:title="@string/remixer_spoofing"
        android:summary="@string/remixer_spoofing_summary"
        android:fragment="com.resurrection.settings.spoof.fragments.miscellaneous.Spoofing" />

</PreferenceScreen>
