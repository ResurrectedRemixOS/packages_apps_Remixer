<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    android:title="@string/remixer_navigation">

    <Preference
        android:key="sidebar_page"
        android:title="@string/sidebar_settings_title"
        android:summary="@string/sidebar_settings_summary"
        android:fragment="com.resurrection.settings.sidebar.SidebarSettings" />

    <Preference
        android:key="pie_page"
        android:title="@string/pie_title"
        android:summary="@string/pie_summary"
        android:fragment="com.resurrection.settings.gestures.PieSettings" />

    <Preference
        android:key="gesture_anywhere_page"
        android:title="@string/gesture_anywhere_title"
        android:summary="@string/gesture_anywhere_summary"
        android:fragment="com.resurrection.settings.gestures.GestureAnywhereSettings" />

    <Preference
        android:key="remixer_pulse"
        android:title="@string/remixer_pulse"
        android:summary="@string/remixer_pulse_summary" />

    <lineageos.preference.LineagePartsPreference
        android:key="button_settings" />

    <Preference
        android:key="remixer_navbar"
        android:title="@string/remixer_navbar_category"
        android:summary="@string/remixer_navbar_summary"
        android:fragment="com.resurrection.settings.RemixerSection">
        <extra android:name="section" android:value="navbar" />
    </Preference>

</PreferenceScreen>
