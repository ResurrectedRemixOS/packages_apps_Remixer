    <Preference
        android:key="remixer_fonts"
        android:title="@string/remixer_fonts"
        android:summary="@string/remixer_fonts_summary" />

    <Preference
        android:key="remixer_wallpapers"
        android:title="@string/remixer_wallpapers"
        android:summary="@string/remixer_wallpapers_summary" />

    <Preference
        android:key="remixer_accents"
        android:title="@string/remixer_accents"
