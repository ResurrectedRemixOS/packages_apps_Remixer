<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:title="@string/remixer_statusbar">

    <lineageos.preference.LineagePartsPreference
        android:key="status_bar_settings" />

    <PreferenceCategory
        android:key="sb_battery_category"
        android:title="@string/battery_style_page_title">

        <lineageos.preference.LineageSystemSettingListPreference
            android:key="status_bar_battery_style"
            android:title="@string/battery_style_title"
            android:entries="@array/battery_style_entries"
            android:entryValues="@array/battery_style_values"
            android:summary="%s"
            android:defaultValue="0" />

        <lineageos.preference.LineageSystemSettingListPreference
            android:key="status_bar_show_battery_percent"
            android:title="@string/battery_percent_title"
            android:entries="@array/battery_percent_entries"
            android:entryValues="@array/battery_percent_values"
            android:summary="%s"
            android:defaultValue="0" />

        <com.resurrection.settings.preferences.SystemSettingListPreference
            android:key="status_bar_battery_ring_color"
            android:title="@string/battery_ring_color_title"
            android:entries="@array/battery_ring_color_entries"
            android:entryValues="@array/battery_ring_color_values"
            android:summary="@string/battery_ring_color_summary"
            android:defaultValue="0" />

        <lineageos.preference.SystemSettingSwitchPreference
            android:key="status_bar_battery_ring_spark"
            android:title="@string/battery_ring_spark_title"
            android:defaultValue="true" />

        <lineageos.preference.SystemSettingSwitchPreference
            android:key="qs_battery_ring"
            android:title="@string/battery_ring_tile_title"
            android:summary="@string/battery_ring_tile_summary"
            android:defaultValue="true" />
    </PreferenceCategory>

    <PreferenceCategory
        android:key="sb_clock_category"
        android:title="@string/sb_clock_category">

        <com.resurrection.settings.preferences.SystemSettingListPreference
            android:key="status_bar_clock_rr_style"
            android:title="@string/status_bar_clock_rr_style_title"
            android:entries="@array/status_bar_clock_rr_style_entries"
            android:entryValues="@array/status_bar_clock_rr_style_values"
            android:summary="%s"
            android:defaultValue="0" />

        <lineageos.preference.SystemSettingSwitchPreference
            android:key="status_bar_clock_bold"
            android:title="@string/sb_clock_bold_title"
            android:summary="@string/sb_clock_bold_summary"
            android:defaultValue="false" />

        <lineageos.preference.SystemSettingSwitchPreference
            android:key="status_bar_clock_period_separator"
            android:title="@string/sb_clock_period_separator_title"
            android:summary="@string/sb_clock_period_separator_summary"
            android:defaultValue="false" />

        <com.resurrection.settings.preferences.SystemSettingListPreference
            android:key="status_bar_clock_date_display"
            android:title="@string/sb_clock_date_title"
            android:summary="%s"
            android:entries="@array/sb_clock_date_entries"
            android:entryValues="@array/sb_clock_date_values"
            android:defaultValue="0" />

        <com.resurrection.settings.preferences.SystemSettingListPreference
            android:key="status_bar_clock_date_position"
            android:title="@string/sb_clock_date_position_title"
            android:summary="%s"
            android:entries="@array/sb_clock_date_position_entries"
            android:entryValues="@array/sb_clock_date_position_values"
            android:defaultValue="0" />

        <com.resurrection.settings.preferences.SystemSettingListPreference
            android:key="status_bar_clock_date_style"
            android:title="@string/sb_clock_date_style_title"
            android:summary="%s"
            android:entries="@array/sb_clock_date_style_entries"
            android:entryValues="@array/sb_clock_date_style_values"
            android:defaultValue="0" />

        <com.resurrection.settings.preferences.SystemSettingListPreference
            android:key="status_bar_clock_date_format"
            android:title="@string/sb_clock_date_format_title"
            android:summary="%s"
            android:entries="@array/sb_clock_date_formats"
            android:entryValues="@array/sb_clock_date_formats"
            android:defaultValue="EEE" />
    </PreferenceCategory>

    <PreferenceCategory
        android:key="sb_weather_category"
        android:title="@string/sb_weather_category">

        <com.resurrection.settings.preferences.SystemSettingListPreference
            android:key="status_bar_weather"
            android:title="@string/sb_weather_title"
            android:summary="%s"
            android:entries="@array/sb_weather_entries"
            android:entryValues="@array/sb_weather_values"
            android:defaultValue="0" />

        <com.resurrection.settings.preferences.SystemSettingListPreference
            android:key="status_bar_weather_position"
            android:title="@string/sb_weather_position_title"
            android:summary="%s"
            android:entries="@array/sb_weather_position_entries"
            android:entryValues="@array/sb_weather_position_values"
            android:defaultValue="0" />

        <Preference
            android:key="remixer_weather_service"
            android:title="@string/remixer_weather_service" />
    </PreferenceCategory>

    <PreferenceCategory
        android:key="sb_clock_chip_category"
        android:title="@string/sb_clock_chip_category">

        <com.resurrection.settings.preferences.SystemSettingListPreference
            android:key="statusbar_clock_chip"
            android:title="@string/sb_clock_chip_title"
            android:summary="%s"
            android:entries="@array/sb_clock_chip_entries"
            android:entryValues="@array/sb_clock_chip_values"
            android:defaultValue="0" />

        <com.resurrection.settings.preferences.SystemSettingColorPreference
            android:key="statusbar_clock_chip_gradient_start_color"
            android:title="@string/sb_clock_chip_start_title"
            android:defaultValue="#FF6B6B" />

        <com.resurrection.settings.preferences.SystemSettingColorPreference
            android:key="statusbar_clock_chip_gradient_end_color"
            android:title="@string/sb_clock_chip_end_title"
            android:defaultValue="#4ECDC4" />

        <com.resurrection.settings.preferences.SystemSettingSeekBarPreference
            android:key="statusbar_clock_chip_gradient_angle"
            android:title="@string/sb_clock_chip_angle_title"
            android:defaultValue="0"
            android:max="360"
            app:min="0"
            app:showSeekBarValue="true" />

        <lineageos.preference.SystemSettingSwitchPreference
            android:key="statusbar_clock_chip_gradient_mask_text"
            android:title="@string/sb_clock_chip_mask_title"
            android:summary="@string/sb_clock_chip_mask_summary"
            android:defaultValue="false" />
    </PreferenceCategory>

</PreferenceScreen>
