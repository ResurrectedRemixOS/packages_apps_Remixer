<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:title="@string/remixer_theme">

    <Preference
        android:key="remixer_looks"
        android:title="@string/looks_title"
        android:summary="@string/looks_summary" />
    <com.resurrection.settings.preferences.SystemSettingListPreference
        android:key="rr_look_roulette"
        android:title="@string/look_roulette_title"
        android:summary="%s"
        android:entries="@array/look_roulette_entries"
        android:entryValues="@array/look_roulette_values"
        android:defaultValue="0" />

    <Preference
        android:key="remixer_modes"
        android:title="@string/remix_modes_title"
        android:summary="@string/remix_modes_summary"
        android:fragment="com.resurrection.settings.modes.RemixModesSettings" />

    <Preference
        android:key="remixer_liquid_glass"
        android:title="@string/liquid_glass_title"
        android:summary="@string/liquid_glass_summary"
        android:fragment="com.resurrection.settings.glass.LiquidGlassSettings" />

    <Preference
        android:key="remixer_fonts"
        android:title="@string/remixer_fonts"
        android:summary="@string/remixer_fonts_summary" />

    <Preference
        android:key="remixer_accents"
        android:title="@string/remixer_accents"
        android:summary="@string/remixer_accents_summary" />

    <Preference
        android:key="remixer_wallpapers"
        android:title="@string/remixer_wallpapers"
        android:summary="@string/remixer_wallpapers_summary" />

    <Preference
        android:key="remixer_boot_animation"
        android:title="@string/remixer_boot_animation" />

    <Preference
        android:key="remixer_settings_style"
        android:title="@string/remixer_settings_style" />

</PreferenceScreen>
