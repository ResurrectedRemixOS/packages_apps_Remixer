<!-- Liquid Glass on the power menu, menus and dialogs -->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    android:title="@string/glass_section_power">

    <lineageos.preference.SystemSettingSwitchPreference
        android:key="rr_glass_power"
        android:title="@string/liquid_glass_power_title"
        android:summary="@string/liquid_glass_power_summary"
        android:defaultValue="true" />

    <lineageos.preference.SystemSettingSwitchPreference
        android:key="rr_glass_power_blur_behind"
        android:title="@string/glass_power_menu_blur_behind_title"
        android:summary="@string/glass_power_menu_blur_behind_summary"
        android:dependency="rr_glass_power"
        android:defaultValue="false" />

    <lineageos.preference.SystemSettingSwitchPreference
        android:key="rr_glass_morph_power_menu"
        android:title="@string/glass_morph_power_menu_title"
        android:summary="@string/glass_morph_power_menu_summary"
        android:defaultValue="true" />

    <lineageos.preference.SystemSettingSwitchPreference
        android:key="rr_glass_menus"
        android:title="@string/liquid_glass_menus_title"
        android:summary="@string/liquid_glass_menus_summary"
        android:defaultValue="true" />
</PreferenceScreen>
