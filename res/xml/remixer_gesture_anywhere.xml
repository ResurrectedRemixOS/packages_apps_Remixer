<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:title="@string/gesture_anywhere_title">

    <lineageos.preference.SystemSettingMainSwitchPreference
        android:key="gesture_anywhere"
        android:title="@string/gesture_anywhere_title"
        android:summary="@string/gesture_anywhere_summary"
        android:defaultValue="false" />

    <PreferenceCategory
        android:key="gesture_anywhere_builtin"
        android:title="@string/gesture_anywhere_gestures">

    <Preference
        android:key="gesture_anywhere_c"
        android:title="@string/gesture_c"
        android:dependency="gesture_anywhere" />

    <Preference
        android:key="gesture_anywhere_m"
        android:title="@string/gesture_m"
        android:dependency="gesture_anywhere" />

    <Preference
        android:key="gesture_anywhere_down"
        android:title="@string/gesture_down"
        android:dependency="gesture_anywhere" />

    <Preference
        android:key="gesture_anywhere_o"
        android:title="@string/gesture_o"
        android:dependency="gesture_anywhere" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="gesture_anywhere_custom_list"
        android:title="@string/gesture_anywhere_custom" />

    <Preference
        android:key="gesture_anywhere_add"
        android:title="@string/gesture_anywhere_add"
        android:dependency="gesture_anywhere">
        <intent
            android:targetPackage="com.android.settings"
            android:targetClass="com.resurrection.settings.gestures.GestureRecordActivity" />
    </Preference>

    <PreferenceCategory
        android:key="gesture_anywhere_strip"
        android:title="@string/gesture_anywhere_strip">

    <com.resurrection.settings.preferences.SystemSettingListPreference
        android:key="gesture_anywhere_side"
        android:title="@string/gesture_anywhere_side"
        android:entries="@array/gesture_side_entries"
        android:entryValues="@array/gesture_side_values"
        android:summary="%s"
        android:defaultValue="0"
        android:dependency="gesture_anywhere" />

    <com.resurrection.settings.preferences.SystemSettingSeekBarPreference
        android:key="gesture_anywhere_position"
        android:title="@string/gesture_anywhere_position"
        android:defaultValue="50"
        android:max="100"
        app:min="0"
        app:showSeekBarValue="true"
        android:dependency="gesture_anywhere" />

    <com.resurrection.settings.preferences.SystemSettingSeekBarPreference
        android:key="gesture_anywhere_length"
        android:title="@string/gesture_anywhere_length"
        android:defaultValue="30"
        android:max="80"
        app:min="10"
        app:showSeekBarValue="true"
        android:dependency="gesture_anywhere" />

    <lineageos.preference.SystemSettingSwitchPreference
        android:key="gesture_anywhere_preview"
        android:title="@string/gesture_anywhere_preview"
        android:defaultValue="true"
        android:dependency="gesture_anywhere" />

    </PreferenceCategory>

    <com.android.settingslib.widget.FooterPreference
        android:key="gesture_anywhere_footer"
        android:title="@string/gesture_anywhere_footer"
        android:selectable="false" />
</PreferenceScreen>
