<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/header_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:theme="@style/Theme.Material3.DynamicColors.DayNight"
    android:clipToPadding="false"
    android:paddingBottom="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/header_preview_card"
            style="@style/Widget.Material3.CardView.Filled"
            android:layout_width="match_parent"
            android:layout_height="142dp"
            android:layout_marginTop="8dp"
            app:cardBackgroundColor="@color/remixer_header_shade"
            app:cardCornerRadius="28dp">

            <ImageView
                android:id="@+id/header_preview_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop" />

            <View
                android:id="@+id/header_preview_fade"
                android:layout_width="match_parent"
                android:layout_height="78dp"
                android:layout_gravity="bottom"
                android:background="@drawable/remixer_header_fade" />

            <TextView
                android:id="@+id/header_preview_empty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/header_preview_none"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="#B3FFFFFF"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_marginStart="20dp"
                android:layout_marginBottom="14dp"
                android:orientation="vertical">

                <TextClock
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:format12Hour="h:mm"
                    android:format24Hour="H:mm"
                    android:importantForAccessibility="no"
                    android:textAppearance="?attr/textAppearanceHeadlineMedium"
                    android:textColor="#FFFFFFFF" />

                <TextClock
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:format12Hour="EEE, MMM d"
                    android:format24Hour="EEE, MMM d"
                    android:importantForAccessibility="no"
                    android:textAppearance="?attr/textAppearanceLabelLarge"
                    android:textColor="#D9FFFFFF" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/header_switch_card"
            style="@style/Widget.Material3.CardView.Filled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:clickable="true"
            android:focusable="true"
            app:cardCornerRadius="28dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="72dp"
                android:orientation="horizontal"
                android:paddingVertical="12dp"
                android:paddingStart="24dp"
                android:paddingEnd="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/header_switch_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/header_switch"
                        android:textAppearance="?attr/textAppearanceTitleMedium" />

                    <TextView
                        android:id="@+id/header_switch_summary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/header_switch_summary"
                        android:textAppearance="?attr/textAppearanceBodyMedium" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/header_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:importantForAccessibility="no" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:id="@+id/header_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/RemixerHeaderSectionTitle"
                android:text="@string/header_source" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/header_source"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/header_source_collection"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/header_source_collection" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/header_source_image"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/header_source_image" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/header_source_photo"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/header_source_photo" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <LinearLayout
                android:id="@+id/header_gallery"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/RemixerHeaderSectionTitle"
                    android:text="@string/header_collections" />

                <TextView
                    android:id="@+id/header_collections_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/header_collections"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="-16dp"
                    android:clipToPadding="false"
                    android:paddingHorizontal="12dp" />

                <TextView
                    android:id="@+id/header_images_title"
                    style="@style/RemixerHeaderSectionTitle" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/header_images"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="-4dp"
                    android:nestedScrollingEnabled="false" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/header_photo_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/header_photo"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="24dp"
                    android:text="@string/header_photo_choose"
                    app:icon="@drawable/remixer_ic_header_photo"
                    app:iconGravity="textStart" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_horizontal"
                    android:text="@string/header_photo_summary"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant" />
            </LinearLayout>

            <TextView
                style="@style/RemixerHeaderSectionTitle"
                android:text="@string/header_look" />

            <TextView
                android:id="@+id/header_height_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceTitleSmall" />

            <com.google.android.material.slider.Slider
                android:id="@+id/header_height"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:contentDescription="@string/header_height"
                android:valueFrom="100"
                android:valueTo="200" />

            <TextView
                android:id="@+id/header_shadow_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textAppearance="?attr/textAppearanceTitleSmall" />

            <com.google.android.material.slider.Slider
                android:id="@+id/header_shadow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:contentDescription="@string/header_shadow"
                android:valueFrom="0"
                android:valueTo="200" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
