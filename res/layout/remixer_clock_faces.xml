<?xml version="1.0" encoding="utf-8"?>
<!-- The stage stays pinned above the options and shrinks while they scroll. Settings themes turn
     child clipping off, so the root turns it back on or the options draw over the stage. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/clock_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="true"
    android:orientation="vertical"
    android:theme="@style/Theme.Material3.DynamicColors.DayNight">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/clock_stage_card"
        style="@style/Widget.Material3.CardView.Filled"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        app:cardBackgroundColor="@color/remixer_header_shade"
        app:cardCornerRadius="28dp">

        <FrameLayout
            android:id="@+id/clock_stage"
            android:layout_width="match_parent"
            android:layout_height="320dp">

            <ImageView
                android:id="@+id/clock_stage_wallpaper"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop" />

            <ImageView
                android:id="@+id/clock_stage_face"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY" />

            <TextView
                android:id="@+id/clock_stage_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:paddingHorizontal="24dp"
                android:gravity="center"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="#FFFFFFFF"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/clock_stage_progress"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_margin="16dp"
                android:indeterminateTint="#FFFFFFFF"
                android:visibility="gone" />
        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/clock_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/clock_face_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceTitleLarge" />

                <TextView
                    android:id="@+id/clock_face_position"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/clock_face_apply"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="@string/clock_faces_apply" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/clock_face_strip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:clipToPadding="false"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp" />

        <LinearLayout
            android:id="@+id/clock_look"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp">

            <TextView
                style="@style/RemixerHeaderSectionTitle"
                android:text="@string/clock_faces_color" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/clock_color_mode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/clock_color_default"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/clock_faces_color_default" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/clock_color_accent"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/clock_faces_color_accent" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/clock_color_custom"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/clock_faces_color_custom" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/clock_color_album"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/clock_faces_color_album" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/clock_color_gradient"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/clock_faces_color_gradient" />
            </com.google.android.material.chip.ChipGroup>

            <TextView
                android:id="@+id/clock_color_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/clock_swatches"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal" />

            <TextView
                style="@style/RemixerHeaderSectionTitle"
                android:text="@string/clock_faces_size_position" />

            <TextView
                android:id="@+id/clock_size_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceTitleSmall" />

            <com.google.android.material.slider.Slider
                android:id="@+id/clock_size"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:contentDescription="@string/clock_faces_size"
                android:stepSize="5"
                android:valueFrom="50"
                android:valueTo="150" />

            <TextView
                android:id="@+id/clock_top_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textAppearance="?attr/textAppearanceTitleSmall" />

            <com.google.android.material.slider.Slider
                android:id="@+id/clock_top"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:contentDescription="@string/clock_faces_top"
                android:stepSize="1"
                android:valueFrom="0"
                android:valueTo="200" />

            <TextView
                android:id="@+id/clock_start_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textAppearance="?attr/textAppearanceTitleSmall" />

            <com.google.android.material.slider.Slider
                android:id="@+id/clock_start"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:contentDescription="@string/clock_faces_horizontal"
                android:stepSize="2"
                android:valueFrom="-120"
                android:valueTo="120" />

            <TextView
                android:id="@+id/clock_opacity_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textAppearance="?attr/textAppearanceTitleSmall" />

            <com.google.android.material.slider.Slider
                android:id="@+id/clock_opacity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:contentDescription="@string/clock_faces_opacity"
                android:stepSize="5"
                android:valueFrom="10"
                android:valueTo="100" />

            <TextView
                style="@style/RemixerHeaderSectionTitle"
                android:text="@string/clock_faces_motion" />

            <include
                android:id="@+id/clock_wobble_row"
                layout="@layout/remixer_clock_switch_row" />

            <include
                android:id="@+id/clock_aod_row"
                layout="@layout/remixer_clock_switch_row" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:paddingHorizontal="20dp"
            android:text="@string/clock_faces_note"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant" />
    </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
