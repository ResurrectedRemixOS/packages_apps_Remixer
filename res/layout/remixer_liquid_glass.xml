<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="8dp"
    android:paddingEnd="16dp"
    android:paddingBottom="8dp">

    <com.resurrection.settings.glass.GlassPreviewView
        android:id="@+id/liquid_glass_preview"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:importantForAccessibility="no" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="10dp"
        android:accessibilityHeading="true"
        android:fontFamily="sans-serif-medium"
        android:text="@string/liquid_glass_material_title"
        android:textColor="?android:attr/colorAccent"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <include
            android:id="@+id/liquid_glass_solid"
            layout="@layout/remixer_liquid_glass_material"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:layout_weight="1" />

        <include
            android:id="@+id/liquid_glass_frosted"
            layout="@layout/remixer_liquid_glass_material"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:layout_weight="1" />

        <include
            android:id="@+id/liquid_glass_liquid"
            layout="@layout/remixer_liquid_glass_material"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />
    </LinearLayout>
</LinearLayout>
