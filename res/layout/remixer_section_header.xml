<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingTop="8dp"
    android:paddingEnd="16dp"
    android:paddingBottom="16dp">

    <FrameLayout
        android:id="@+id/remixer_section_card"
        android:layout_width="match_parent"
        android:layout_height="188dp">

        <com.resurrection.settings.HubPreviewView
            android:id="@+id/remixer_section_stage"
            android:layout_width="136dp"
            android:layout_height="72dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="10dp"
            android:importantForAccessibility="no"
            android:scaleX="1.5"
            android:scaleY="1.5"
            android:transformPivotX="68dp"
            android:transformPivotY="72dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="18dp"
            android:paddingEnd="20dp">

            <TextView
                android:id="@+id/remixer_section_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:textColor="@android:color/white"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/remixer_section_summary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#C2FFFFFF"
                android:textSize="13sp" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
