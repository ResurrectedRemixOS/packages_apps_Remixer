     The preview pinned at the top of a glass page (GlassPreview): the strip, with the glass in a
     window of its own over it, and its buttons.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="?android:attr/listPreferredItemPaddingStart"
    android:paddingEnd="?android:attr/listPreferredItemPaddingEnd"
    android:paddingBottom="8dp">

    <com.resurrection.settings.glass.GlassPreviewStrip
        android:id="@+id/glass_preview_strip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <LinearLayout
        android:id="@+id/glass_preview_buttons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/glass_preview_background"
            style="@style/GlassPreviewButton"
            android:layout_width="wrap_content"
            android:background="@drawable/glass_preview_button"
            android:textColor="@color/glass_preview_button_text" />

        <TextView
            android:id="@+id/glass_preview_real"
            style="@style/GlassPreviewButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@drawable/glass_preview_button_real"
            android:text="@string/glass_preview_show_real"
            android:textColor="@color/glass_preview_real_text" />

    </LinearLayout>

</LinearLayout>
