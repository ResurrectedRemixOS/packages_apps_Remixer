<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.Material3.CardView.Filled"
    android:layout_width="76dp"
    android:layout_height="102dp"
    android:layout_marginHorizontal="4dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/remixer_header_shade"
    app:cardCornerRadius="16dp"
    app:strokeWidth="3dp">

    <ImageView
        android:id="@+id/clock_thumb_wallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <ImageView
        android:id="@+id/clock_thumb_face"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY" />

    <TextView
        android:id="@+id/clock_thumb_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:paddingHorizontal="4dp"
        android:textAppearance="?attr/textAppearanceLabelSmall"
        android:textColor="#FFFFFFFF"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/clock_thumb_applied"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_gravity="top|end"
        android:layout_margin="5dp"
        android:background="@drawable/remixer_pulse_swatch"
        android:importantForAccessibility="no"
        android:padding="2dp"
        android:scaleType="fitCenter"
        android:src="@drawable/remixer_ic_pulse_check"
        android:visibility="gone" />
</com.google.android.material.card.MaterialCardView>
