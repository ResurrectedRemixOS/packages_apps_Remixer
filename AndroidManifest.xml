<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.resurrection.settings">

    <uses-permission android:name="android.permission.CHANGE_OVERLAY_PACKAGES" />
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />

    <application
        android:label="@string/remixer_app_name"
        android:icon="@android:drawable/ic_menu_preferences"
        android:theme="@android:style/Theme.DeviceDefault.DayNight">

        <activity
            android:name=".RemixerActivity"
            android:exported="true"
            android:label="@string/remixer_app_name">
            <intent-filter>
                <action android:name="com.resurrection.settings.REMIXER" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".FontActivity"
            android:exported="false"
            android:label="@string/remixer_fonts" />

        <activity
            android:name=".WallpaperActivity"
            android:exported="false"
            android:label="@string/remixer_wallpapers" />

        <activity
            android:name=".AccentActivity"
            android:exported="false"
            android:label="@string/remixer_accents" />

        <activity
            android:name=".PulseActivity"
            android:exported="false"
            android:label="@string/remixer_pulse" />

        <activity
            android:name=".HeaderActivity"
            android:exported="false"
            android:label="@string/remixer_headers" />

        <activity
            android:name=".QsStyleActivity"
            android:exported="false"
            android:label="@string/remixer_qs_style" />

        <activity
            android:name=".ClockFaceActivity"
            android:exported="false"
            android:label="@string/remixer_clock_faces" />

        <activity
            android:name=".BootAnimationActivity"
            android:exported="false"
            android:label="@string/remixer_boot_animation" />
    </application>
</manifest>
